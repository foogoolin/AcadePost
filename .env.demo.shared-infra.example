# AcadePost shared-infra demo environment.
# Copy to `.env.demo.shared-infra` on the server and change the placeholders.
# This file is for servers that already have Caddy, external PostgreSQL,
# and Docker networks named `proxy` and `backend`.

ACADEPOST_PUBLIC_URL=https://YOUR_DOMAIN
NEXT_PUBLIC_BACKEND_URL=/api
ACADEPOST_IMAGE=acadepost/app:demo
ACADEPOST_DATA_DIR=/opt/AcadePost/data
NEXT_PUBLIC_VERSION=demo
ACADEPOST_DEMO_DB_PUSH=false
NODE_BUILD_MAX_OLD_SPACE_SIZE=4096
NODE_RUNTIME_MAX_OLD_SPACE_SIZE=4096

PROXY_NETWORK=proxy
BACKEND_NETWORK=backend

# External application PostgreSQL. Create this DB/user in the shared Postgres first.
DATABASE_URL=postgresql://acadepost:CHANGE_ME_APP_DB_PASSWORD@postgres:5432/acadepost

# External Temporal PostgreSQL. Create temporal and temporal_visibility DBs first.
TEMPORAL_POSTGRES_HOST=postgres
TEMPORAL_POSTGRES_PORT=5432
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=CHANGE_ME_TEMPORAL_DB_PASSWORD
TEMPORAL_DB=temporal
TEMPORAL_VISIBILITY_DB=temporal_visibility

JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
DISABLE_REGISTRATION=false
IS_GENERAL=true
TRUST_PROXY=true

STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=/uploads

API_LIMIT=30
NX_ADD_PLUGINS=false

# Optional demo integrations. Leave empty until real apps are configured.
OPENAI_API_KEY=
NEXT_PUBLIC_DISCORD_SUPPORT=
NEXT_PUBLIC_POLOTNO=

X_URL=
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BEEHIIVE_API_KEY=
BEEHIIVE_PUBLICATION_ID=
THREADS_APP_ID=
THREADS_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=
SLACK_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# Stripe is intentionally empty for raw demo mode.
FEE_AMOUNT=0.05
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SIGNING_KEY=
STRIPE_SIGNING_KEY_CONNECT=

# Optional: enable `--profile debug` to expose Temporal UI on localhost only.
TEMPORAL_UI_BIND=127.0.0.1
TEMPORAL_UI_PORT=8080
