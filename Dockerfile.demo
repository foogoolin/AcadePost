FROM node:22.20-bookworm-slim

ARG NEXT_PUBLIC_VERSION=demo
ARG NODE_BUILD_MAX_OLD_SPACE_SIZE=4096

ENV NODE_ENV=production
ENV CI=1
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    g++ \
    make \
    netcat-openbsd \
    nginx \
    openssl \
    python3 \
  && rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
  && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
  && mkdir -p /www /uploads /config \
  && chown -R www:www /www /var/lib/nginx /uploads /config

RUN corepack enable \
  && corepack prepare pnpm@10.6.1 --activate \
  && npm --no-update-notifier --no-fund --global install pm2

WORKDIR /app

COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

RUN touch /app/.env \
  && corepack pnpm install --frozen-lockfile \
  && MAIN_URL="http://build.local" \
    FRONTEND_URL="http://build.local" \
    NEXT_PUBLIC_BACKEND_URL="/api" \
    NEXT_PUBLIC_UPLOAD_DIRECTORY="/uploads" \
    NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY="/uploads" \
    DATABASE_URL="postgresql://acadepost-user:acadepost-password@localhost:5432/acadepost-db-local" \
    REDIS_URL="redis://localhost:6379" \
    BACKEND_INTERNAL_URL="http://127.0.0.1:3000" \
    TEMPORAL_ADDRESS="temporal:7233" \
    IS_GENERAL="true" \
    NODE_OPTIONS="--max-old-space-size=${NODE_BUILD_MAX_OLD_SPACE_SIZE}" \
    corepack pnpm run build

EXPOSE 5000

CMD ["sh", "/app/deploy/demo/entrypoint.sh"]
