# syntax=docker/dockerfile:1.7

FROM node:22.20-bookworm-slim AS base

ARG NEXT_PUBLIC_VERSION=demo
ARG NODE_BUILD_MAX_OLD_SPACE_SIZE=4096

ENV CI=1 \
  COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
  NEXT_TELEMETRY_DISABLED=1 \
  NEXT_PUBLIC_VERSION=${NEXT_PUBLIC_VERSION} \
  PNPM_HOME=/pnpm \
  PATH=/pnpm:$PATH

RUN corepack enable \
  && corepack prepare pnpm@10.6.1 --activate

FROM base AS deps

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.json tsconfig.base.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/commands/package.json apps/commands/package.json
COPY apps/extension/package.json apps/extension/package.json
COPY apps/frontend/package.json apps/frontend/package.json
COPY apps/orchestrator/package.json apps/orchestrator/package.json
COPY apps/sdk/package.json apps/sdk/package.json

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm fetch --frozen-lockfile

FROM deps AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    openssl \
    python3 \
  && rm -rf /var/lib/apt/lists/*

COPY . .

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile --offline \
  && printf 'ACADEPOST_DOCKER_BUILD=1\n' > /app/.env \
  && MAIN_URL="http://build.local" \
    FRONTEND_URL="http://build.local" \
    NEXT_PUBLIC_BACKEND_URL="/api" \
    NEXT_PUBLIC_UPLOAD_DIRECTORY="/uploads" \
    NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY="/uploads" \
    DATABASE_URL="postgresql://acadepost-user:acadepost-password@localhost:5432/acadepost-db-local" \
    REDIS_URL="redis://localhost:6379" \
    BACKEND_INTERNAL_URL="http://127.0.0.1:3000" \
    TEMPORAL_ADDRESS="temporal:7233" \
    IS_GENERAL="true" \
    NODE_OPTIONS="--max-old-space-size=${NODE_BUILD_MAX_OLD_SPACE_SIZE}" \
    pnpm run build \
  && pnpm prune --prod \
  && find /app/apps/backend/dist /app/apps/orchestrator/dist /app/apps/frontend/.next -type f \( -name '*.map' -o -name '*.tsbuildinfo' \) -delete \
  && rm -rf \
    /app/.env \
    /app/.next \
    /app/.nx \
    /app/apps/frontend/.next/cache \
    /app/apps/frontend/.next/diagnostics \
    /app/apps/frontend/.next/dev \
    /app/apps/frontend/.next/types \
    /app/apps/frontend/.next/trace \
    /app/apps/frontend/.next/trace-build \
    /root/.cache \
    /tmp/* \
  && node scripts/docker/trace-server-runtime.cjs /app/.runtime/server \
  && mkdir -p /app/.runtime/frontend \
  && cp -R /app/apps/frontend/.next/standalone/. /app/.runtime/frontend/ \
  && mkdir -p /app/.runtime/frontend/apps/frontend/.next /app/.runtime/frontend/.next \
  && cp -R /app/apps/frontend/.next/static /app/.runtime/frontend/apps/frontend/.next/static \
  && cp -R /app/apps/frontend/public /app/.runtime/frontend/apps/frontend/public \
  && cp -R /app/apps/frontend/.next/static /app/.runtime/frontend/.next/static \
  && cp -R /app/apps/frontend/public /app/.runtime/frontend/public

FROM node:22.20-bookworm-slim AS runner

ARG NEXT_PUBLIC_VERSION=demo

ENV NODE_ENV=production \
  NEXT_TELEMETRY_DISABLED=1 \
  NEXT_PUBLIC_VERSION=${NEXT_PUBLIC_VERSION}

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    netcat-openbsd \
    openssl \
  && rm -rf /var/lib/apt/lists/* \
  && addgroup --system --gid 10001 www \
  && adduser --system --uid 10001 --ingroup www --home /www --shell /usr/sbin/nologin www \
  && mkdir -p /app /uploads /config \
  && chown -R www:www /app /uploads /config

WORKDIR /app

COPY --from=builder --chown=www:www /app/.runtime/server ./
COPY --from=builder --chown=www:www /app/.runtime/frontend ./frontend-standalone
COPY --from=builder --chown=www:www /app/libraries/nestjs-libraries/src/database/prisma ./libraries/nestjs-libraries/src/database/prisma
COPY --from=builder --chown=www:www /app/package.json ./package.json
COPY --from=builder --chown=www:www /app/deploy/demo/app-entrypoint.sh ./deploy/demo/app-entrypoint.sh

USER www

EXPOSE 3000 3002 4200

ENTRYPOINT ["sh", "/app/deploy/demo/app-entrypoint.sh"]
CMD ["backend"]
