# syntax=docker/dockerfile:1.7

FROM node:22.20-bookworm-slim AS base

ARG NEXT_PUBLIC_VERSION=demo
ARG NODE_BUILD_MAX_OLD_SPACE_SIZE=4096

ENV CI=1 \
  COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
  NEXT_TELEMETRY_DISABLED=1 \
  NEXT_PUBLIC_VERSION=${NEXT_PUBLIC_VERSION} \
  PNPM_HOME=/pnpm \
  PATH=/pnpm:$PATH

RUN corepack enable \
  && corepack prepare pnpm@10.6.1 --activate

FROM base AS deps

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.json tsconfig.base.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/commands/package.json apps/commands/package.json
COPY apps/extension/package.json apps/extension/package.json
COPY apps/frontend/package.json apps/frontend/package.json
COPY apps/orchestrator/package.json apps/orchestrator/package.json
COPY apps/sdk/package.json apps/sdk/package.json

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm fetch --frozen-lockfile

FROM deps AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    openssl \
    python3 \
  && rm -rf /var/lib/apt/lists/*

COPY . .

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile --offline \
  && touch /app/.env \
  && MAIN_URL="http://build.local" \
    FRONTEND_URL="http://build.local" \
    NEXT_PUBLIC_BACKEND_URL="/api" \
    NEXT_PUBLIC_UPLOAD_DIRECTORY="/uploads" \
    NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY="/uploads" \
    DATABASE_URL="postgresql://acadepost-user:acadepost-password@localhost:5432/acadepost-db-local" \
    REDIS_URL="redis://localhost:6379" \
    BACKEND_INTERNAL_URL="http://127.0.0.1:3000" \
    TEMPORAL_ADDRESS="temporal:7233" \
    IS_GENERAL="true" \
    NODE_OPTIONS="--max-old-space-size=${NODE_BUILD_MAX_OLD_SPACE_SIZE}" \
    pnpm run build \
  && pnpm prune --prod \
  && pnpm exec prisma --version \
  && rm -rf \
    /app/.env \
    /app/.next \
    /app/.nx \
    /app/apps/frontend/.next/cache \
    /app/apps/frontend/.next/diagnostics \
    /app/apps/frontend/.next/types \
    /app/apps/frontend/.next/trace \
    /app/apps/frontend/.next/trace-build \
    /root/.cache \
    /tmp/* \
  && find /app/apps/backend/dist /app/apps/orchestrator/dist /app/apps/frontend/.next -type f -name '*.map' -delete

FROM node:22.20-bookworm-slim AS runner

ARG NEXT_PUBLIC_VERSION=demo

ENV NODE_ENV=production \
  NEXT_TELEMETRY_DISABLED=1 \
  NEXT_PUBLIC_VERSION=${NEXT_PUBLIC_VERSION} \
  PNPM_HOME=/pnpm \
  PATH=/pnpm:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    netcat-openbsd \
    nginx \
    openssl \
  && rm -rf /var/lib/apt/lists/* \
  && addgroup --system www \
  && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
  && mkdir -p /www /uploads /config /run/nginx \
  && chown -R www:www /www /var/lib/nginx /uploads /config /run/nginx \
  && corepack enable \
  && corepack prepare pnpm@10.6.1 --activate \
  && npm --no-update-notifier --no-fund --global install pm2

WORKDIR /app

COPY --from=builder /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/backend/package.json ./apps/backend/package.json
COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder /app/apps/frontend/package.json ./apps/frontend/package.json
COPY --from=builder /app/apps/frontend/next.config.js ./apps/frontend/next.config.js
COPY --from=builder /app/apps/frontend/public ./apps/frontend/public
COPY --from=builder /app/apps/frontend/.next ./apps/frontend/.next
COPY --from=builder /app/apps/orchestrator/package.json ./apps/orchestrator/package.json
COPY --from=builder /app/apps/orchestrator/dist ./apps/orchestrator/dist
COPY --from=builder /app/libraries/nestjs-libraries/src/database/prisma ./libraries/nestjs-libraries/src/database/prisma
COPY --from=builder /app/deploy/demo/entrypoint.sh ./deploy/demo/entrypoint.sh
COPY --from=builder /app/ecosystem.demo.config.cjs ./ecosystem.demo.config.cjs
COPY --from=builder /app/var/docker/nginx.conf /etc/nginx/nginx.conf

EXPOSE 5000

CMD ["sh", "/app/deploy/demo/entrypoint.sh"]
