# AcadePost raw demo server environment.
# Copy to `.env.demo` on the server and change the public URL and secrets.

ACADEPOST_PUBLIC_URL=http://YOUR_SERVER_IP:4007
NEXT_PUBLIC_BACKEND_URL=http://YOUR_SERVER_IP:4007/api
ACADEPOST_PORT=4007
ACADEPOST_IMAGE=acadepost/app:demo
NEXT_PUBLIC_VERSION=demo
ACADEPOST_DEMO_DB_PUSH=true
NODE_BUILD_MAX_OLD_SPACE_SIZE=4096
NODE_RUNTIME_MAX_OLD_SPACE_SIZE=4096

POSTGRES_USER=acadepost-user
POSTGRES_PASSWORD=change-this-demo-postgres-password
POSTGRES_DB=acadepost-db-local

TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=change-this-demo-temporal-password

JWT_SECRET=change-this-demo-jwt-secret-use-a-long-random-string
DISABLE_REGISTRATION=false
IS_GENERAL=true
TRUST_PROXY=false

STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=/uploads

API_LIMIT=30
NX_ADD_PLUGINS=false

# Optional demo integrations. Leave empty until you configure real apps.
OPENAI_API_KEY=
NEXT_PUBLIC_DISCORD_SUPPORT=
NEXT_PUBLIC_POLOTNO=

X_URL=
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BEEHIIVE_API_KEY=
BEEHIIVE_PUBLICATION_ID=
THREADS_APP_ID=
THREADS_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=
SLACK_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# Stripe is intentionally empty for raw demo mode.
FEE_AMOUNT=0.05
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SIGNING_KEY=
STRIPE_SIGNING_KEY_CONNECT=

# Optional: enable `--profile debug` to expose Temporal UI.
TEMPORAL_UI_PORT=8080
