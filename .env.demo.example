# AcadePost raw demo server environment.
# Copy to `.env.demo` on the server and change the public URL and secrets.

ACADEPOST_PUBLIC_URL=http://YOUR_SERVER_IP:4007
NEXT_PUBLIC_BACKEND_URL=http://YOUR_SERVER_IP:4007/api
ACADEPOST_PORT=4007
ACADEPOST_IMAGE=ghcr.io/foogoolin/acadepost:latest
NEXT_PUBLIC_VERSION=v1.1.6
ACADEPOST_DEMO_DB_PUSH=true
NODE_BUILD_MAX_OLD_SPACE_SIZE=4096
NODE_RUNTIME_MAX_OLD_SPACE_SIZE=4096

POSTGRES_USER=acadepost-user
POSTGRES_PASSWORD=change-this-demo-postgres-password
POSTGRES_DB=acadepost-db-local

TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=change-this-demo-temporal-password

JWT_SECRET=change-this-demo-jwt-secret-use-a-long-random-string
ACADEPOST_CREDENTIALS_ENCRYPTION_KEY=change-this-demo-credentials-encryption-key-use-hex-64
DISABLE_REGISTRATION=false
IS_GENERAL=true
TRUST_PROXY=false
PUBLIC_API_ALLOW_OAUTH=false

STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=/uploads

API_LIMIT=30
NX_ADD_PLUGINS=false

# Optional demo integrations. Placeholder values show the expected format.
# Replace them with real credentials or set them empty to disable the provider.
OPENAI_API_KEY=sk-proj-...
NEXT_PUBLIC_DISCORD_SUPPORT=
NEXT_PUBLIC_POLOTNO=

X_URL=
X_API_KEY=x-api-key-placeholder
X_API_SECRET=x-api-secret-placeholder
DISABLE_X_ANALYTICS=
LINKEDIN_CLIENT_ID=linkedin-client-id-placeholder
LINKEDIN_CLIENT_SECRET=linkedin-client-secret-placeholder
REDDIT_CLIENT_ID=reddit-client-id-placeholder
REDDIT_CLIENT_SECRET=reddit-client-secret-placeholder
GITHUB_CLIENT_ID=github-client-id-placeholder
GITHUB_CLIENT_SECRET=github-client-secret-placeholder
BEEHIIVE_API_KEY=beehiiv-api-key-placeholder
BEEHIIVE_PUBLICATION_ID=beehiiv-publication-id-placeholder
THREADS_APP_ID=threads-app-id-placeholder
THREADS_APP_SECRET=threads-app-secret-placeholder
FACEBOOK_APP_ID=meta-app-id-placeholder
FACEBOOK_APP_SECRET=meta-app-secret-placeholder
INSTAGRAM_APP_ID=instagram-app-id-placeholder
INSTAGRAM_APP_SECRET=instagram-app-secret-placeholder
YOUTUBE_CLIENT_ID=youtube-client-id-placeholder
YOUTUBE_CLIENT_SECRET=youtube-client-secret-placeholder
GOOGLE_GMB_CLIENT_ID=google-gmb-client-id-placeholder
GOOGLE_GMB_CLIENT_SECRET=google-gmb-client-secret-placeholder
TIKTOK_CLIENT_ID=tiktok-client-id-placeholder
TIKTOK_CLIENT_SECRET=tiktok-client-secret-placeholder
PINTEREST_CLIENT_ID=pinterest-client-id-placeholder
PINTEREST_CLIENT_SECRET=pinterest-client-secret-placeholder
DRIBBBLE_CLIENT_ID=dribbble-client-id-placeholder
DRIBBBLE_CLIENT_SECRET=dribbble-client-secret-placeholder
DISCORD_CLIENT_ID=discord-client-id-placeholder
DISCORD_CLIENT_SECRET=discord-client-secret-placeholder
DISCORD_BOT_TOKEN_ID=discord-bot-token-placeholder
SLACK_ID=slack-client-id-placeholder
SLACK_SECRET=slack-client-secret-placeholder
SLACK_SIGNING_SECRET=slack-signing-secret-placeholder
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=mastodon-client-id-placeholder
MASTODON_CLIENT_SECRET=mastodon-client-secret-placeholder
TELEGRAM_TOKEN=1234567890:telegram-bot-token-placeholder
TELEGRAM_BOT_NAME=acadepost_bot
TWITCH_CLIENT_ID=twitch-client-id-placeholder
TWITCH_CLIENT_SECRET=twitch-client-secret-placeholder
KICK_CLIENT_ID=kick-client-id-placeholder
KICK_SECRET=kick-client-secret-placeholder
VK_ID=vk-app-id-placeholder
NEYNAR_CLIENT_ID=neynar-client-id-placeholder
NEYNAR_SECRET_KEY=neynar-secret-key-placeholder
NEYNAR_LOGIN_URL=https://app.neynar.com/login
MEWE_HOST=https://mewe.com
MEWE_APP_ID=mewe-app-id-placeholder
MEWE_API_KEY=mewe-api-key-placeholder
WHOP_CLIENT_ID=whop-client-id-placeholder
NEXT_PUBLIC_FACEBOOK_PIXEL=

# Stripe is intentionally empty for raw demo mode.
FEE_AMOUNT=0.05
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_SIGNING_KEY=whsec_...
STRIPE_SIGNING_KEY_CONNECT=whsec_...

# Optional: enable `--profile debug` to expose Temporal UI.
TEMPORAL_UI_BIND=127.0.0.1
TEMPORAL_UI_PORT=8080
